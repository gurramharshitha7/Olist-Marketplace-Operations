      </column>
      <column caption='Customer Segment' datatype='string' name='[Calculation_0736167041490944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_orders] &gt; 1 THEN &quot;Repeat Customer&quot; ELSE &quot;One-Time Customer&quot; END' />
      </column>
      <column caption='Order Id Text' datatype='string' name='[Calculation_0736167102390273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([order_id])' />
      </column>
      <column caption='Review Score Color' datatype='string' name='[Calculation_0737816243433472]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([average_review_score]) &gt;= 4 THEN &quot;Good&quot;&#13;&#10;ELSEIF AVG([average_review_score]) &lt; 3 THEN &quot;Poor&quot;&#13;&#10;ELSE &quot;Average&quot;&#13;&#10;END' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_0737816260853761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Brazil&quot;' />
      </column>
      <column caption='Stage 1 - Placed' datatype='integer' name='[Calculation_0737816284958722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Stage 2 - Approved' datatype='integer' name='[Calculation_0737816285077507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([order_approved_at]) THEN [order_id] END)' />
      </column>
      <column caption='Stage 3 - Shipped' datatype='integer' name='[Calculation_0737816285155332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([order_delivered_carrier_date]) THEN [order_id] END)' />
      </column>
      <column caption='Stage 4 - Delivered' datatype='integer' name='[Calculation_0737816285302789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([order_delivered_customer_date]) THEN [order_id] END)' />
      </column>
      <column caption='Delay Bucket' datatype='string' name='[Calculation_0737816295645197]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([delivery_variance_days]) THEN &quot;Not Delivered&quot;&#13;&#10;ELSEIF [delivery_variance_days] &lt; -1 THEN &quot;Early&quot;&#13;&#10;ELSEIF [delivery_variance_days] &lt;= 1 THEN &quot;On Time&quot;&#13;&#10;ELSEIF [delivery_variance_days] &lt;= 3 THEN &quot;1-3 Days Late&quot;&#13;&#10;ELSEIF [delivery_variance_days] &lt;= 7 THEN &quot;4-7 Days Late&quot;&#13;&#10;ELSE &quot;7+ Days Late&quot;&#13;&#10;END' />
      </column>

          <datasource-dependencies datasource='federated.1w5jei51msvlmt1222z6c0jn0oxl'>
            <column caption='Delay Bucket' datatype='string' name='[Calculation_0737816295645197]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([delivery_variance_days]) THEN &quot;Not Delivered&quot;&#13;&#10;ELSEIF [delivery_variance_days] &lt; -1 THEN &quot;Early&quot;&#13;&#10;ELSEIF [delivery_variance_days] &lt;= 1 THEN &quot;On Time&quot;&#13;&#10;ELSEIF [delivery_variance_days] &lt;= 3 THEN &quot;1-3 Days Late&quot;&#13;&#10;ELSEIF [delivery_variance_days] &lt;= 7 THEN &quot;4-7 Days Late&quot;&#13;&#10;ELSE &quot;7+ Days Late&quot;&#13;&#10;END' />
            </column>
            <column caption='Average Review Score' datatype='real' name='[average_review_score]' role='measure' type='quantitative' />
            <column-instance column='[average_review_score]' derivation='Avg' name='[avg:average_review_score:qk]' pivot='key' type='quantitative' />
            <column caption='Delivery Variance Days' datatype='real' name='[delivery_variance_days]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0737816295645197]' derivation='None' name='[none:Calculation_0737816295645197:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1w5jei51msvlmt1222z6c0jn0oxl].[none:Calculation_0737816295645197:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_0737816295645197:nk]' member='&quot;1-3 Days Late&quot;' />
              <groupfilter function='member' level='[none:Calculation_0737816295645197:nk]' member='&quot;4-7 Days Late&quot;' />
              <groupfilter function='member' level='[none:Calculation_0737816295645197:nk]' member='&quot;7+ Days Late&quot;' />
              <groupfilter function='member' level='[none:Calculation_0737816295645197:nk]' member='&quot;Early&quot;' />
              <groupfilter function='member' level='[none:Calculation_0737816295645197:nk]' member='&quot;On Time&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.1w5jei51msvlmt1222z6c0jn0oxl].[none:Calculation_0737816295645197:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Early&quot;</bucket>
              <bucket>&quot;On Time&quot;</bucket>
              <bucket>&quot;1-3 Days Late&quot;</bucket>
